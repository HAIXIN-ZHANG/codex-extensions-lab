{
  "description": "Check for published SkillDock skill updates without installing them.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node \"${PLUGIN_ROOT}/skills/skilldock-update/scripts/updates.ts\" hook --host codex",
            "timeout": 8,
            "statusMessage": "Checking SkillDock updates",
            "additionalContextLimit": 450
          }
        ]
      }
    ]
  }
}
