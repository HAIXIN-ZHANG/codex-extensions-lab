{
  "description": "Check for published SkillDock skill updates without installing them.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/skilldock-update/scripts/updates.ts\" hook --host claude",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
